PORT=3000
HOST=0.0.0.0
# Public URL of this app (must match the Google OAuth redirect URI).
BASE_URL=http://localhost:3000
# Google Cloud OAuth client credentials:
#   https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Comma-separated emails allowed to set other people's ranks (admins).
GOOGLE_ADMIN_EMAIL=
# Optional: random 64-char string. Auto-generated and persisted if omitted.
SESSION_SECRET=